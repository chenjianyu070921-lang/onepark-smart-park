syntax = "v1"

// notice-service 公告通知服务 API 契约
// 对齐 docs/M2物业管理服务模块设计文档(V1.1) 第三节 / 第十一节.
// 核心: 发布公告/通知, 公告列表查询, 已读统计(Redis PubSub 推送).
// 说明: returns 类型均为 data 载荷, 由 handler 经 response.Ok/Fail 包装为统一响应体.
// CreateNoticeReq 发布公告请求
type CreateNoticeReq {
	Title     string `json:"title"`
	Content   string `json:"content"`
	Type      int8   `json:"type"` // 1通知 2公告 3活动 4停水 5停电
	Top       bool   `json:"top,optional"` // 是否置顶
	PublishAt int64  `json:"publish_at,optional"` // 定时发布(秒级时间戳), 0=立即发布
}

// NoticeResp 公告响应
type NoticeResp {
	Id        int64  `json:"id"`
	Title     string `json:"title"`
	Type      int8   `json:"type"`
	Status    int8   `json:"status"` // 1草稿 2已发布 3已撤回
	Top       bool   `json:"top"`
	PublishAt int64  `json:"publish_at,optional"`
}

// ListNoticeReq 公告分页请求
type ListNoticeReq {
	Type     int8  `form:"type,optional"`
	Status   int8  `form:"status,optional"`
	Page     int64 `form:"page"`
	PageSize int64 `form:"page_size"`
}

// NoticeItem 公告列表项
type NoticeItem {
	Id        int64  `json:"id"`
	Title     string `json:"title"`
	Type      int8   `json:"type"`
	Status    int8   `json:"status"`
	Top       bool   `json:"top"`
	PublishAt int64  `json:"publish_at,optional"`
	CreatedAt int64  `json:"created_at"`
}

// NoticeListResp 公告分页响应
type NoticeListResp {
	Total int64        `json:"total"`
	List  []NoticeItem `json:"list"`
}

// NoticeUnreadCountResp 未读计数响应(站内信送达未读数, 来源于 notice_read)
type NoticeUnreadCountResp {
	UnreadCount int64 `json:"unread_count"`
}

// MarkNoticeReadReq 公告已读回填请求(当前登录用户对指定公告回填已读时间)
type MarkNoticeReadReq {
	NoticeId int64 `json:"notice_id"`
}

// MarkNoticeReadResp 公告已读回填响应
type MarkNoticeReadResp {
	Updated int64 `json:"updated"` // 实际回填条数(0=无未读记录或已读)
}

service notice-api {
	@handler CreateNotice
	post /api/notice (CreateNoticeReq) returns (NoticeResp)

	@handler ListNotices
	get /api/notices (ListNoticeReq) returns (NoticeListResp)

	// 站内信未读计数(P2: notice_read 中当前用户 read_at IS NULL 条数)
	@handler NoticeUnreadCount
	get /api/notices/unread-count returns (NoticeUnreadCountResp)

	// 公告已读回填(P2: 与未读计数配套, 当前用户对指定公告回填 read_at)
	@handler MarkNoticeRead
	post /api/notices/read (MarkNoticeReadReq) returns (MarkNoticeReadResp)

	// 公告已读回填(路径参数版别名, 与上面 body 版同语义同逻辑, 评审 P1 要求的 RESTful 风格)
	@handler MarkNoticeReadById
	post /api/notice/:id/read returns (MarkNoticeReadResp)
}

