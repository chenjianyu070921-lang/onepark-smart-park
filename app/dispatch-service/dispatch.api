syntax = "v1"

type DispatchTask {
	Id         int64  `json:"id"`
	TenantId   int64  `json:"tenant_id"`
	Title      string `json:"title"`
	AssigneeId int64  `json:"assignee_id"`
	Priority   int32  `json:"priority"`
	Status     int32  `json:"status"`
	CreatedAt  int64  `json:"created_at"`
}

type ListDispatchReq {
	TenantId int64 `form:"tenant_id,optional"`
	Status   int32 `form:"status,optional"`
}

type ListDispatchResp {
	Total int64           `json:"total"`
	List  []*DispatchTask `json:"list"`
}

@server (
	prefix: /api/dispatch
)
service dispatch-api {
	@handler ListDispatchTasks
	get /tasks (ListDispatchReq) returns (ListDispatchResp)
}

