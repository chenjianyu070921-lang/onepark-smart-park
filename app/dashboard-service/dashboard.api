syntax = "v1"

info (
	title:   "M5 指挥大屏聚合 API"
	desc:    "OnePark 智慧园区 M5 运营招商+指挥调度 - dashboard-service"
	version: "1.0"
)

type (
	// ==================== 卡片(按数据源拆分, 便于逐源降级) ====================
	// WorkOrderCard 工单卡片, 数据源: M2 workorder-service ListWorkOrders
	WorkOrderCard {
		Available    bool     `json:"available"` // 该路数据是否可用(false = 降级)
		TodayTotal   int64    `json:"today_total"` // 今日新增工单数
		Unfinished   int64    `json:"unfinished"` // 未完成(待派单 + 处理中)
		AvgHandleSec *float64 `json:"avg_handle_sec"` // 平均处理时长(秒); M2 契约未暴露 finished_at 时为 null
		CompleteRate float64  `json:"complete_rate"` // 完成率, 取值 0~1
	}
	// AlarmCard 告警卡片, 数据源: M3 alarm-service GetActiveAlarms
	// 等级口径对齐 M3 app/alarm-service/internal/model/alarm.go:
	//   1 提示 / 2 一般 / 3 严重 / 4 紧急
	// 四个分项之和恒等于 total, 便于前端直接校验与展示
	AlarmCard {
		Total    int64 `json:"total"` // 活跃告警总数
		Critical int64 `json:"critical"` // level=4 紧急: 需立即响应
		Major    int64 `json:"major"` // level=3 严重: 需及时处理
		Minor    int64 `json:"minor"` // level=2 一般: 需关注
		Info     int64 `json:"info"` // level=1 提示: 一般提示性事件
	}
	// DeviceCard 设备卡片, 数据源: M1 device-service GetDeviceStat
	// device.status 有三个取值(0离线/1在线/2故障), 故必须有三项分项,
	// 保证 total = online + offline + fault —— 否则只算两项时总数会对不上
	DeviceCard {
		Total   int64 `json:"total"`
		Online  int64 `json:"online"`
		Offline int64 `json:"offline"`
		Fault   int64 `json:"fault"` // status=2 故障
	}
	// EnergyCard 能耗卡片, 数据源: M4 energy-data-service GetDailyReport
	EnergyCard {
		TotalKwh   float64  `json:"total_kwh"` // 当日总用电(度)
		TotalWater *float64 `json:"total_water"` // 当日总用水(吨); M4 契约当前未提供该指标 -> null, 不用 0 冒充
	}
	// ==================== 首页概览 ====================
	HomeReq {
		TenantId int64 `header:"X-Tenant-Id,default=0"`
	}
	HomeResp {
		WorkOrder WorkOrderCard `json:"work_order"`
		UpdatedAt int64         `json:"updated_at"`
		ElapsedMs int64         `json:"elapsed_ms"`
	}
	// ==================== 综合查询 ====================
	OverviewReq {
		TenantId int64 `header:"X-Tenant-Id,default=0"`
	}
	OverviewResp {
		// 每一路失败时对应字段为 null, 并在 degraded 中列出, 保证接口整体不返回 5xx
		WorkOrder *WorkOrderCard `json:"work_order"`
		Alarm     *AlarmCard     `json:"alarm"`
		Device    *DeviceCard    `json:"device"`
		Energy    *EnergyCard    `json:"energy"`
		Degraded  []string       `json:"degraded"` // 降级的数据源标识列表
		Cached    bool           `json:"cached"` // 是否命中 Redis 缓存
		UpdatedAt int64          `json:"updated_at"`
		ElapsedMs int64          `json:"elapsed_ms"`
	}
)

@server (
	prefix: /api/dashboard
	group:  dashboard
)
service dashboard-api {
	@handler Home
	get /home (HomeReq) returns (HomeResp)

	@handler Overview
	get /overview (OverviewReq) returns (OverviewResp)
}

