syntax = "v1"

// 工单统计(首页概览与综合查询共用)
type WorkOrderStat {
	TenantId          int64   `json:"tenant_id"`
	Total             int64   `json:"total"`
	TodayCount        int64   `json:"today_count"`
	PendingCount      int64   `json:"pending_count"`
	CompletedToday    int64   `json:"completed_today"`
	AvgProcessMinutes float64 `json:"avg_process_minutes"`
	CompletionRate    float64 `json:"completion_rate"`
}

// 首页概览响应: 已就绪数据源填充真实值, 未就绪字段为 null 并记降级标记
type OverviewResp {
	TenantId        int64          `json:"tenant_id"`
	WorkOrder       *WorkOrderStat `json:"work_order,omitempty"`
	FallbackMarkers []string       `json:"fallback_markers,omitempty"`
	Cached          bool           `json:"cached"`
}

// 告警统计(M3 未就绪时为 null)
type AlarmStat {
	ActiveCount int64 `json:"active_count"`
}

// 设备统计(M1 未就绪时为 null)
type DeviceStat {
	TotalCount  int64 `json:"total_count"`
	OnlineCount int64 `json:"online_count"`
}

// 停车统计(M2 未就绪时为 null)
type ParkingStat {
	OccupiedSpaces int64 `json:"occupied_spaces"`
}

// 公告统计(M2 未就绪时为 null)
type NoticeStat {
	PublishedCount int64 `json:"published_count"`
}

// 综合查询响应: 多维数据源并行聚合, 每路独立降级
type QueryResp {
	TenantId        int64          `json:"tenant_id"`
	WorkOrder       *WorkOrderStat `json:"work_order,omitempty"`
	Alarm           *AlarmStat     `json:"alarm,omitempty"`
	Device          *DeviceStat    `json:"device,omitempty"`
	Parking         *ParkingStat   `json:"parking,omitempty"`
	Notice          *NoticeStat    `json:"notice,omitempty"`
	FallbackMarkers []string       `json:"fallback_markers,omitempty"`
	Cached          bool           `json:"cached"`
}

@server (
	prefix: /api/dashboard
)
service dashboard-api {
	@handler Overview
	get /overview returns (OverviewResp)

	@handler Query
	get /query returns (QueryResp)
}

