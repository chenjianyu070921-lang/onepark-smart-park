syntax = "v1"

// video-service 视频服务 API 契约
// 对齐 docs/m3/04-接口与数据契约.md §1.3:
//   #49 POST /api/video/camera         添加摄像头
//   #50 GET  /api/video/cameras        摄像头列表 + 在线状态
//   #51 GET  /api/video/stream/:id     获取视频流地址
// 统一响应体见 common/response {code,msg,data}, 成功 code="0"; 各 handler 通过 response.Ok/Fail 回包.
// 说明: M3 只管理摄像头元数据与流地址下发, 不实现转码/推流(docs/m3/11).

// Location 摄像头位置
type Location {
	Lng   float64 `json:"lng"`           // 经度
	Lat   float64 `json:"lat"`           // 纬度
	Floor string  `json:"floor,optional"` // 楼层
}

// AddCameraReq 添加摄像头请求(#49)
type AddCameraReq {
	Name     string    `json:"name"`               // 摄像头名称
	DeviceId string    `json:"device_id"`          // 关联 M1 设备ID(租户内唯一)
	AreaId   int64     `json:"area_id,optional"`   // 区域ID
	RtspUrl  string    `json:"rtsp_url"`           // RTSP 拉流地址
	Location *Location `json:"location,optional"`  // 位置信息
	Status   int8      `json:"status,optional"`    // 1在线/0离线/2故障, 默认 0 离线
}

// AddCameraResp 添加摄像头响应
type AddCameraResp {
	Id int64 `json:"id"` // 新建摄像头ID
}

// CameraItem 摄像头列表项(#50)
type CameraItem {
	Id              int64  `json:"id"`
	Name            string `json:"name"`
	DeviceId        string `json:"device_id"`
	AreaId          int64  `json:"area_id"`
	Status          int8   `json:"status"`            // 1在线/0离线/2故障
	LastHeartbeatAt int64  `json:"last_heartbeat_at"` // 最近心跳(秒级时间戳, 0表示从未上报)
	CreatedAt       int64  `json:"created_at"`
}

// ListCamerasReq 摄像头列表请求
type ListCamerasReq {
	AreaId   int64 `form:"area_id,optional"` // 区域筛选, 0表示全部
	Status   int8  `form:"status,optional"`  // 状态筛选: -1或不传表示全部
	Page     int64 `form:"page"`
	PageSize int64 `form:"page_size"`
}

// ListCamerasResp 摄像头分页列表响应
type ListCamerasResp {
	Total    int64        `json:"total"`
	Page     int64        `json:"page"`
	PageSize int64        `json:"page_size"`
	List     []CameraItem `json:"list"`
}

// IdReq 按ID查询请求
type IdReq {
	Id int64 `path:"id"` // 摄像头ID(路径参数)
}

// UpdateCameraReq 修改摄像头请求(#49 地址簿维护)
// 只传需要改的字段; area_id/status 用指针是因为 0 是合法取值(未分配区域 / 离线).
type UpdateCameraReq {
	Id       int64     `path:"id"`                  // 摄像头ID(路径参数)
	Name     string    `json:"name,optional"`        // 摄像头名称
	AreaId   *int64    `json:"area_id,optional"`     // 区域ID
	RtspUrl  string    `json:"rtsp_url,optional"`    // RTSP 拉流地址
	Location *Location `json:"location,optional"`    // 位置信息
	Status   *int8     `json:"status,optional"`      // 1在线/0离线/2故障
}

// UpdateCameraResp 修改摄像头响应
type UpdateCameraResp {
	Id int64 `json:"id"` // 摄像头ID
}

// DeleteCameraResp 删除摄像头响应
type DeleteCameraResp {
	Id int64 `json:"id"` // 已删除的摄像头ID
}

// CameraDetailResp 摄像头详情(#49 地址簿详情)
type CameraDetailResp {
	Id              int64  `json:"id"`
	Name            string `json:"name"`
	DeviceId        string `json:"device_id"`
	AreaId          int64  `json:"area_id"`
	RtspUrl         string `json:"rtsp_url"`
	Status          int8   `json:"status"`
	LastHeartbeatAt int64  `json:"last_heartbeat_at"`
	CreatedAt       int64  `json:"created_at"`
	UpdatedAt       int64  `json:"updated_at"`
}

// StreamResp 视频流地址响应(#51)
type StreamResp {
	CameraId  int64  `json:"camera_id"`
	RtspUrl   string `json:"rtsp_url"`
	FlvUrl    string `json:"flv_url"`     // 未配置流媒体服务时为空串; 启用签名后带 expires/sign 参数
	ExpiresAt int64  `json:"expires_at"`  // 有效期截止(秒级时间戳)
	Sign      string `json:"sign"`        // 时效签名(HMAC-SHA256), 未配置 Stream.SignSecret 时为空串
	SignAlg   string `json:"sign_alg"`    // 签名算法标识; Sign 为空时同样为空串
}

// ###########################################################################
// 录像计划 + 回放
// M3 只负责"什么时候录、录多久可回看"的策略层与回放授权, 不存媒体文件
// (录像实体由流媒体网关承载, 见 docs/m3/11); 回放接口返回的是按计划推导出的可用录像窗口.
// ###########################################################################

// CreateRecordPlanReq 创建录像计划请求
type CreateRecordPlanReq {
	CameraId      int64  `json:"camera_id"`
	Name          string `json:"name"`
	Strategy      string `json:"strategy,optional"`       // always 全天(默认) / scheduled 定时
	DaysOfWeek    string `json:"days_of_week,optional"`   // scheduled 生效日: 1=周一..7=周日; 空表示每天
	StartMinute   int    `json:"start_minute,optional"`   // 当日起始分钟 0-1439
	EndMinute     int    `json:"end_minute,optional"`     // 当日结束分钟 1-1440(不支持跨零点)
	RetentionDays int    `json:"retention_days,optional"` // 录像保留天数, 默认取配置 7 天
	Status        *int8  `json:"status,optional"`         // 1启用(默认)/0停用
}

// CreateRecordPlanResp 创建录像计划响应
type CreateRecordPlanResp {
	Id int64 `json:"id"`
}

// UpdateRecordPlanReq 修改录像计划请求, 传什么改什么
type UpdateRecordPlanReq {
	Id            int64   `path:"id"`
	Name          string  `json:"name,optional"`
	Strategy      string  `json:"strategy,optional"`
	DaysOfWeek    *string `json:"days_of_week,optional"` // 传空串表示改为每天生效
	StartMinute   *int    `json:"start_minute,optional"`
	EndMinute     *int    `json:"end_minute,optional"`
	RetentionDays *int    `json:"retention_days,optional"`
	Status        *int8   `json:"status,optional"`
}

// UpdateRecordPlanResp 修改录像计划响应
type UpdateRecordPlanResp {
	Id int64 `json:"id"`
}

// DeleteRecordPlanResp 删除录像计划响应
type DeleteRecordPlanResp {
	Id int64 `json:"id"`
}

// RecordPlanItem 录像计划列表项
type RecordPlanItem {
	Id            int64  `json:"id"`
	CameraId      int64  `json:"camera_id"`
	Name          string `json:"name"`
	Strategy      string `json:"strategy"`
	DaysOfWeek    string `json:"days_of_week"`
	StartMinute   int    `json:"start_minute"`
	EndMinute     int    `json:"end_minute"`
	RetentionDays int    `json:"retention_days"`
	Status        int8   `json:"status"`
	CreatedAt     int64  `json:"created_at"`
	UpdatedAt     int64  `json:"updated_at"`
}

// ListRecordPlansReq 录像计划列表请求
type ListRecordPlansReq {
	CameraId int64 `form:"camera_id,optional"` // 0 表示全部摄像头
	Status   int8  `form:"status,optional"`    // -1 或不传表示全部
	Page     int64 `form:"page,optional"`
	PageSize int64 `form:"page_size,optional"`
}

// ListRecordPlansResp 录像计划分页列表响应
type ListRecordPlansResp {
	Total    int64            `json:"total"`
	Page     int64            `json:"page"`
	PageSize int64            `json:"page_size"`
	List     []RecordPlanItem `json:"list"`
}

// PlaybackReq 回放查询请求
type PlaybackReq {
	CameraId  int64 `form:"camera_id"`
	StartTime int64 `form:"start_time"` // 秒级时间戳, 闭区间(左闭)
	EndTime   int64 `form:"end_time"`   // 秒级时间戳, 开区间(右开)
}

// PlaybackSegment 一段可回放录像窗口
type PlaybackSegment {
	PlanId      int64  `json:"plan_id"`
	PlanName    string `json:"plan_name"`
	StartTime   int64  `json:"start_time"`
	EndTime     int64  `json:"end_time"`
	PlaybackUrl string `json:"playback_url"` // 未配置 Record.PlaybackBaseURL 时为空串
	ExpiresAt   int64  `json:"expires_at"`
	Sign        string `json:"sign"`
	SignAlg     string `json:"sign_alg"`
}

// PlaybackResp 回放查询结果
type PlaybackResp {
	CameraId  int64             `json:"camera_id"`
	StartTime int64             `json:"start_time"`
	EndTime   int64             `json:"end_time"`
	HasPlan   bool              `json:"has_plan"` // 是否存在启用中的录像计划
	Total     int64             `json:"total"`
	List      []PlaybackSegment `json:"list"`
}

service video-api {
	@handler AddCamera
	post /api/video/camera (AddCameraReq) returns (AddCameraResp)

	@handler ListCameras
	get /api/video/cameras (ListCamerasReq) returns (ListCamerasResp)

	@handler GetStream
	get /api/video/stream/:id (IdReq) returns (StreamResp)

	@handler GetCamera
	get /api/video/camera/:id (IdReq) returns (CameraDetailResp)

	@handler UpdateCamera
	put /api/video/camera/:id (UpdateCameraReq) returns (UpdateCameraResp)

	@handler DeleteCamera
	delete /api/video/camera/:id (IdReq) returns (DeleteCameraResp)

	@handler CreateRecordPlan
	post /api/video/record-plan (CreateRecordPlanReq) returns (CreateRecordPlanResp)

	@handler GetRecordPlan
	get /api/video/record-plan/:id (IdReq) returns (RecordPlanItem)

	@handler UpdateRecordPlan
	put /api/video/record-plan/:id (UpdateRecordPlanReq) returns (UpdateRecordPlanResp)

	@handler DeleteRecordPlan
	delete /api/video/record-plan/:id (IdReq) returns (DeleteRecordPlanResp)

	@handler ListRecordPlans
	get /api/video/record-plans (ListRecordPlansReq) returns (ListRecordPlansResp)

	@handler Playback
	get /api/video/playback (PlaybackReq) returns (PlaybackResp)
}
