syntax = "v1"

info (
	title:   "M5 招商租赁 API"
	desc:    "OnePark 智慧园区 M5 运营招商 - leasing-service"
	version: "1.0"
)

type (
	// Contract 租赁合同。金额字段一律用字符串传输, 避免 JSON 浮点精度丢失
	Contract {
		Id              int64   `json:"id"`
		ContractNo      string  `json:"contract_no"`
		TenantId        int64   `json:"tenant_id"`
		TenantName      string  `json:"tenant_name"`
		ZoneCode        string  `json:"zone_code"` // 房间/区域编码, 如 A-3F-301
		AreaSqm         float64 `json:"area_sqm"` // 租赁面积(平方米)
		MonthlyRent     string  `json:"monthly_rent"` // 月租金
		Deposit         string  `json:"deposit"` // 押金
		StartDate       string  `json:"start_date"` // 起租日 yyyy-MM-dd
		EndDate         string  `json:"end_date"` // 终止日 yyyy-MM-dd
		Status          int32   `json:"status"` // 1待生效 2生效中 3已到期 4已终止
		AutoRenew       int32   `json:"auto_renew"` // 1 约定自动续约 0 到期即止
		RenewNoticeDays int64   `json:"renew_notice_days"` // 到期前多少天进入续签提醒窗口
		CreatedAt       int64   `json:"created_at"`
		UpdatedAt       int64   `json:"updated_at"`
	}
	// ==================== 合同创建 ====================
	ContractCreateReq {
		TenantId    int64   `json:"tenant_id"`
		TenantName  string  `json:"tenant_name"`
		ZoneCode    string  `json:"zone_code"`
		AreaSqm     float64 `json:"area_sqm"`
		MonthlyRent string  `json:"monthly_rent"`
		Deposit     string  `json:"deposit,optional"`
		StartDate   string  `json:"start_date"`
		EndDate     string  `json:"end_date"`
		// 自动续约条款: 签约时约定。默认 0(到期即止), 只有显式约定才自动顺延租期。
		AutoRenew       int32 `json:"auto_renew,default=0"`
		RenewNoticeDays int64 `json:"renew_notice_days,default=30"`
	}
	ContractCreateResp {
		Id         int64  `json:"id"`
		ContractNo string `json:"contract_no"`
		Status     int32  `json:"status"`
	}
	// ==================== 合同详情 ====================
	ContractDetailReq {
		Id int64 `path:"id"`
	}
	ContractDetailResp {
		Contract Contract `json:"contract"`
	}
	// ==================== 合同分页列表 ====================
	ContractListReq {
		Status   int32 `form:"status,default=0"` // 0 表示不限
		TenantId int64 `form:"tenant_id,default=0"` // 0 表示不限
		Page     int64 `form:"page,default=1"`
		PageSize int64 `form:"page_size,default=10"`
	}
	ContractListResp {
		Total int64      `json:"total"`
		List  []Contract `json:"list"`
	}
	// ==================== 合同更新 / 续签 / 终止 / 到期 ====================
	ContractUpdateReq {
		Id          int64  `path:"id"`
		Action      string `json:"action"` // activate 生效 | renew 续签 | terminate 终止 | expire 到期 | update 变更
		NewEndDate  string `json:"new_end_date,optional"` // action=renew 时必填
		MonthlyRent string `json:"monthly_rent,optional"` // action=renew 时可调整租金
		Reason      string `json:"reason,optional"` // 终止/到期原因
		// action=update 时可调整续约条款; -1 表示不动
		AutoRenew       int32 `json:"auto_renew,default=-1"`
		RenewNoticeDays int64 `json:"renew_notice_days,default=-1"`
	}
	ContractUpdateResp {
		Id     int64 `json:"id"`
		Status int32 `json:"status"`
	}
	// ==================== 入驻率统计 ====================
	OccupancyReq {
		TenantId int64 `form:"tenant_id,default=0"`
	}
	OccupancyResp {
		TotalAreaSqm  float64 `json:"total_area_sqm"`
		LeasedAreaSqm float64 `json:"leased_area_sqm"`
		OccupancyRate float64 `json:"occupancy_rate"` // 入驻率, 取值 0~1
	}
	// ==================== 到期提醒 ====================
	ContractExpiringReq {
		Days     int64 `form:"days,default=30"` // 未来 N 天内到期; 已逾期未处理的也会返回(days_left 为负)
		Page     int64 `form:"page,default=1"`
		PageSize int64 `form:"page_size,default=10"`
	}
	ExpiringContract {
		Id          int64  `json:"id"`
		ContractNo  string `json:"contract_no"`
		TenantId    int64  `json:"tenant_id"`
		TenantName  string `json:"tenant_name"`
		ZoneCode    string `json:"zone_code"`
		MonthlyRent string `json:"monthly_rent"`
		EndDate     string `json:"end_date"` // 终止日 yyyy-MM-dd
		DaysLeft    int64  `json:"days_left"` // 距终止日剩余天数; 负数表示已逾期
		Status      int32  `json:"status"`
		// AutoRenew=1 的合同到期会自动顺延, 前端应展示"将自动续约"而非"待谈续签"
		AutoRenew int32 `json:"auto_renew"`
		// NeedNotice 是否已进入该合同的续签提醒窗口(依据其 renew_notice_days)
		NeedNotice bool `json:"need_notice"`
	}
	ContractExpiringResp {
		Total int64              `json:"total"`
		List  []ExpiringContract `json:"list"`
	}
	// ==================== 自动生成月度租金账单 ====================
	BillAutoReq {
		Period string `json:"period,optional"` // yyyy-MM, 为空取上一自然月
	}
	BillAutoResp {
		Period  string `json:"period"`
		Created int64  `json:"created"` // 新生成账单数
		Skipped int64  `json:"skipped"` // 幂等跳过数
	}
	// ==================== 租金账单查询 ====================
	// Bill 账单对外契约; 金额用字符串承载 decimal, 与合同口径一致
	Bill {
		Id            int64  `json:"id"`
		BillNo        string `json:"bill_no"`
		ContractId    int64  `json:"contract_id"`
		TenantId      int64  `json:"tenant_id"`
		BillingPeriod string `json:"billing_period"` // 账期 yyyy-MM
		Amount        string `json:"amount"` // 定长 2 位小数字符串
		Status        int32  `json:"status"` // 1 未缴 2 已缴
		CreatedAt     int64  `json:"created_at"`
		UpdatedAt     int64  `json:"updated_at"`
	}
	BillListReq {
		ContractId int64  `form:"contract_id,default=0"` // 0 表示不限
		Period     string `form:"period,optional"` // yyyy-MM, 空表示不限
		Status     int32  `form:"status,default=0"` // 0 表示不限
		TenantId   int64  `form:"tenant_id,default=0"` // 0 表示不限
		Page       int64  `form:"page,default=1"`
		PageSize   int64  `form:"page_size,default=10"`
	}
	BillListResp {
		Total int64  `json:"total"`
		List  []Bill `json:"list"`
	}
	// ==================== 租金账单汇总: 应收 / 已收 / 欠费 ====================
	BillSummaryReq {
		Period   string `form:"period,optional"` // yyyy-MM, 空表示全部账期
		TenantId int64  `form:"tenant_id,default=0"` // 0 表示不限
	}
	BillSummaryResp {
		Period       string `json:"period"`
		BillCount    int64  `json:"bill_count"`
		UnpaidCount  int64  `json:"unpaid_count"`
		UnpaidAmount string `json:"unpaid_amount"` // 欠费金额(decimal 字符串)
		PaidCount    int64  `json:"paid_count"`
		PaidAmount   string `json:"paid_amount"` // 已收金额
		TotalAmount  string `json:"total_amount"` // 应收总额
	}
	// ==================== 租金账单缴费状态 ====================
	BillStatusReq {
		Id     int64  `path:"id"`
		Action string `json:"action"` // pay 标记已缴 | unpay 撤销缴费
	}
	BillStatusResp {
		Id     int64 `json:"id"`
		Status int32 `json:"status"`
	}
	// ==================== 园区可租区域维护(入驻率的分母) ====================
	// 入驻率 = 生效中合同面积 / lease_zone 的可租总面积。
	// 此前 lease_zone 只能手工插库, 导致园区可租面积这个招商基础数据进不了系统。
	ZoneUpsertReq {
		ZoneCode     string  `json:"zone_code"` // 区域/楼层编码, 业务唯一键
		ZoneName     string  `json:"zone_name,optional"`
		TotalAreaSqm float64 `json:"total_area_sqm"` // 可租总面积(平方米), 必须大于 0
	}
	ZoneUpsertResp {
		Id       int64  `json:"id"`
		ZoneCode string `json:"zone_code"`
	}
	Zone {
		Id           int64   `json:"id"`
		ZoneCode     string  `json:"zone_code"`
		ZoneName     string  `json:"zone_name"`
		TotalAreaSqm float64 `json:"total_area_sqm"`
		CreatedAt    int64   `json:"created_at"`
		UpdatedAt    int64   `json:"updated_at"`
	}
	ZoneListReq {
		Page     int64 `form:"page,default=1"`
		PageSize int64 `form:"page_size,default=10"`
	}
	ZoneListResp {
		Total int64  `json:"total"`
		List  []Zone `json:"list"`
	}
)

@server (
	prefix: /api/lease
	group:  lease
)
service leasing-api {
	@handler ContractCreate
	post /contract (ContractCreateReq) returns (ContractCreateResp)

	@handler ContractDetail
	get /contract/:id (ContractDetailReq) returns (ContractDetailResp)

	@handler ContractList
	get /contracts (ContractListReq) returns (ContractListResp)

	@handler ContractUpdate
	put /contract/:id (ContractUpdateReq) returns (ContractUpdateResp)

	@handler ContractExpiring
	get /contracts/expiring (ContractExpiringReq) returns (ContractExpiringResp)

	@handler Occupancy
	get /occupancy (OccupancyReq) returns (OccupancyResp)

	@handler BillAuto
	post /bill/auto (BillAutoReq) returns (BillAutoResp)

	@handler BillList
	get /bills (BillListReq) returns (BillListResp)

	@handler BillSummary
	get /bills/summary (BillSummaryReq) returns (BillSummaryResp)

	@handler BillStatus
	put /bill/:id/status (BillStatusReq) returns (BillStatusResp)

	@handler ZoneUpsert
	post /zone (ZoneUpsertReq) returns (ZoneUpsertResp)

	@handler ZoneList
	get /zones (ZoneListReq) returns (ZoneListResp)
}

