syntax = "v1"

// parking-service 停车管理服务 API 契约
// 对齐 docs/M2物业管理服务模块设计文档(V1.1) 第三节 / 第十一节.
// 核心: 车辆入场记录、离场计费、记录分页、在场列表(数据来自 M1 Kafka 地磁事件).
// 说明: returns 类型均为 data 载荷, 由 handler 经 response.Ok/Fail 包装为统一响应体.
// ParkingEntryReq 车辆入场请求(实际由 Kafka 地磁事件驱动, 亦提供 HTTP 入口便于联调)
type ParkingEntryReq {
	PlateNo     string `json:"plate_no"` // 车牌号
	VehicleType int8   `json:"vehicle_type"` // 1月卡 2临时 3VIP 4异常
	DeviceIDIn  string `json:"device_id_in"` // 入场设备(地磁)ID
}

// ParkingRecordResp 停车记录响应
type ParkingRecordResp {
	Id          int64  `json:"id"`
	PlateNo     string `json:"plate_no"`
	EntryTime   int64  `json:"entry_time"` // 入场时间(秒级时间戳)
	ExitTime    int64  `json:"exit_time,optional"`
	DurationMin int64  `json:"duration_min,optional"` // 停车时长(分钟)
	Fee         string `json:"fee,optional"` // 停车费(decimal 字符串, 避免浮点误差)
	Status      int8   `json:"status"` // 1停车中 2已完成
}

// ParkingExitReq 车辆离场请求(触发计费)
type ParkingExitReq {
	PlateNo     string `json:"plate_no"`
	DeviceIDOut string `json:"device_id_out"` // 出场设备(地磁)ID
}

// ListParkingReq 停车记录分页请求
type ListParkingReq {
	Status   int8   `form:"status,optional"`
	PlateNo  string `form:"plate_no,optional"`
	Page     int64  `form:"page"`
	PageSize int64  `form:"page_size"`
}

// ParkingItem 停车列表项
type ParkingItem {
	Id        int64  `json:"id"`
	PlateNo   string `json:"plate_no"`
	EntryTime int64  `json:"entry_time"`
	ExitTime  int64  `json:"exit_time,optional"`
	Status    int8   `json:"status"`
	Fee       string `json:"fee,optional"`
}

// ParkingListResp 停车分页响应(记录列表与在场列表共用)
type ParkingListResp {
	Total int64         `json:"total"`
	List  []ParkingItem `json:"list"`
}

// ActiveParkingReq 在场车辆查询请求
type ActiveParkingReq {
	Page     int64 `form:"page"`
	PageSize int64 `form:"page_size"`
}

// CreateMonthlyCardReq 创建月卡请求(P2 月卡管理)
type CreateMonthlyCardReq {
	PlateNo   string `json:"plate_no"` // 车牌号
	OwnerName string `json:"owner_name,optional"` // 车主姓名
	Phone     string `json:"phone,optional"` // 联系电话
	StartTime int64  `json:"start_time"` // 生效起(秒级时间戳)
	EndTime   int64  `json:"end_time"` // 生效止(秒级时间戳, 须晚于生效起)
}

// MonthlyCardResp 月卡响应
type MonthlyCardResp {
	Id        int64  `json:"id"`
	PlateNo   string `json:"plate_no"`
	OwnerName string `json:"owner_name,optional"`
	Phone     string `json:"phone,optional"`
	StartTime int64  `json:"start_time"` // 秒级时间戳
	EndTime   int64  `json:"end_time"` // 秒级时间戳(到期时间)
	Status    int8   `json:"status"` // 1生效 2停用
}

// MonthlyCardIdReq 月卡ID请求(停用)
type MonthlyCardIdReq {
	Id int64 `json:"id"`
}

// RenewMonthlyCardReq 月卡续费请求(P2: 延长有效期)
type RenewMonthlyCardReq {
	Id      int64 `json:"id"`
	EndTime int64 `json:"end_time"` // 新到期时间(秒级, 须晚于当前到期时间)
}

// ListMonthlyCardsReq 月卡分页请求(P2: 到期提醒经 expiring_days 筛选)
type ListMonthlyCardsReq {
	Status       int8   `form:"status,optional"` // 1生效 2停用, 0不限
	PlateNo      string `form:"plate_no,optional"` // 车牌模糊查询
	ExpiringDays int64  `form:"expiring_days,optional"` // 到期提醒: 仅返回 N 天内到期的生效月卡
	Page         int64  `form:"page"`
	PageSize     int64  `form:"page_size"`
}

// MonthlyCardItem 月卡列表项
type MonthlyCardItem {
	Id        int64  `json:"id"`
	PlateNo   string `json:"plate_no"`
	OwnerName string `json:"owner_name,optional"`
	Phone     string `json:"phone,optional"`
	StartTime int64  `json:"start_time"`
	EndTime   int64  `json:"end_time"`
	Status    int8   `json:"status"`
	DaysLeft  int64  `json:"days_left,optional"` // 剩余有效天数(不足1天为0, 到期提醒展示用)
}

// MonthlyCardListResp 月卡分页响应
type MonthlyCardListResp {
	Total int64             `json:"total"`
	List  []MonthlyCardItem `json:"list"`
}

// ---- 停车计费规则配置 (P2 计费规则配置接口) ----
type UpsertParkingFeeRuleReq {
	FreeMinutes   int     `json:"free_minutes"`            // 免费时长(分钟)
	HourlyFee     float64 `json:"hourly_fee"`              // 元/小时(必须>0)
	DailyCap      float64 `json:"daily_cap,optional"`      // 每日封顶(元, 0=不封顶)
	EffectiveFrom int64   `json:"effective_from,optional"` // 生效起(秒级, 0=立即)
	EffectiveTo   int64   `json:"effective_to,optional"`   // 生效止(秒级, 0=永久)
}

type ParkingFeeRuleItem {
	Id            int64   `json:"id"`
	FreeMinutes   int     `json:"free_minutes"`
	HourlyFee     float64 `json:"hourly_fee"`
	DailyCap      float64 `json:"daily_cap"`
	EffectiveFrom int64   `json:"effective_from,optional"`
	EffectiveTo   int64   `json:"effective_to,optional"`
}

type ParkingFeeRuleResp {
	Rule *ParkingFeeRuleItem `json:"rule,optional"` // 当前生效规则(无配置为 null)
}

service parking-api {
	@handler ParkingEntry
	post /api/parking/entry (ParkingEntryReq) returns (ParkingRecordResp)

	@handler ParkingExit
	post /api/parking/exit (ParkingExitReq) returns (ParkingRecordResp)

	@handler ListParking
	get /api/parking/records (ListParkingReq) returns (ParkingListResp)

	@handler ActiveParking
	get /api/parking/active (ActiveParkingReq) returns (ParkingListResp)

	// 月卡管理(P2: 创建/续费/停用/列表+到期提醒)
	@handler CreateMonthlyCard
	post /api/parking/monthly-card (CreateMonthlyCardReq) returns (MonthlyCardResp)

	@handler RenewMonthlyCard
	post /api/parking/monthly-card/renew (RenewMonthlyCardReq) returns (MonthlyCardResp)

	@handler DisableMonthlyCard
	post /api/parking/monthly-card/disable (MonthlyCardIdReq) returns (MonthlyCardResp)

	@handler ListMonthlyCards
	get /api/parking/monthly-cards (ListMonthlyCardsReq) returns (MonthlyCardListResp)

	// 停车计费规则配置(P2)
	@handler GetParkingFeeRule
	get /api/parking/fee-rule (IdReq) returns (ParkingFeeRuleResp)

	@handler UpsertParkingFeeRule
	post /api/parking/fee-rule (UpsertParkingFeeRuleReq) returns (ParkingFeeRuleResp)
}

