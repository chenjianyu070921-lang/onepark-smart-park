syntax = "v1"

// OnePark API 网关统一入口契约 (localhost:8080)
// 转发规则见 etc/apigateway-api.yaml 的 Upstreams:
//   /api/devices*    -> device:8001
//   /api/workorders* -> workorder:8082
//   /api/visitors*   -> visitor:8083
//   /api/parking*    -> parking:8084
//   /api/notices*    -> notice:8085
//   /api/alarms*     -> alarm:8009
//   /api/access*     -> access:8010
//   /api/video*      -> video:8011
//   /api/energy*     -> energy:8012
//   /api/billing*    -> billing:8014
//   /api/dashboard*  -> dashboard:8015
//   /api/leasing*    -> leasing:8016
//   /api/dispatch*   -> dispatch:8017
// 业务服务需自行监听对应端口并暴露 /api/<svc> 路由, 网关按前缀透传路径.
// 注: 网关实际转发由 internal/proxy 按 URL 前缀实现, 本文件为团队接口契约.

type Empty {
}

type ProxyResp {
	Code string `json:"code"`
	Msg  string `json:"msg"`
	Data string `json:"data"`
}

@server(
    upstream: device
)
service device-api {
    @handler DeviceProxy
    get /api/devices (Empty) returns (ProxyResp)
}

@server(
    upstream: workorder
)
service workorder-api {
    @handler WorkorderProxy
    get /api/workorders (Empty) returns (ProxyResp)
}

@server(
    upstream: visitor
)
service visitor-api {
    @handler VisitorProxy
    get /api/visitors (Empty) returns (ProxyResp)
}

@server(
    upstream: parking
)
service parking-api {
    @handler ParkingProxy
    get /api/parking (Empty) returns (ProxyResp)
}

@server(
    upstream: notice
)
service notice-api {
    @handler NoticeProxy
    get /api/notices (Empty) returns (ProxyResp)
}

@server(
    upstream: alarm
)
service alarm-api {
    @handler AlarmProxy
    get /api/alarms (Empty) returns (ProxyResp)
}

@server(
    upstream: access
)
service access-api {
    @handler AccessProxy
    get /api/access (Empty) returns (ProxyResp)
}

@server(
    upstream: video
)
service video-api {
    @handler VideoProxy
    get /api/video (Empty) returns (ProxyResp)
}

@server(
    upstream: energy
)
service energy-api {
    @handler EnergyProxy
    get /api/energy (Empty) returns (ProxyResp)
}

@server(
    upstream: billing
)
service billing-api {
    @handler BillingProxy
    get /api/billing (Empty) returns (ProxyResp)
}

@server(
    upstream: dashboard
)
service dashboard-api {
    @handler DashboardProxy
    get /api/dashboard (Empty) returns (ProxyResp)
}

@server(
    upstream: leasing
)
service leasing-api {
    @handler LeasingProxy
    get /api/leasing (Empty) returns (ProxyResp)
}

@server(
    upstream: dispatch
)
service dispatch-api {
    @handler DispatchProxy
    get /api/dispatch (Empty) returns (ProxyResp)
}
