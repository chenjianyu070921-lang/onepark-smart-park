# OnePark 智慧园区 - 中间件配置
# 复制为 .env 后按需修改: cp .env.example .env

# ===== 镜像版本 =====
MYSQL_VERSION=8.0
REDIS_VERSION=7-alpine
TDENGINE_VERSION=3.3.3.0
KAFKA_VERSION=3.7
EMQX_VERSION=5.5.1
NACOS_VERSION=v2.4.3
MINIO_VERSION=latest
ES_VERSION=8.13.4

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=onepark123
MYSQL_PORT=3306
# 容器内主机名(docker-compose 网络) + 用户中心库名(usermanage-api.yaml 引用 ${MYSQL_HOST}/${MYSQL_DATABASE})
MYSQL_HOST=mysql
MYSQL_DATABASE=sys_db

# ===== Redis =====
REDIS_PASSWORD=onepark123
REDIS_PORT=6379

# ===== TDengine =====
TDENGINE_PORT=6030
TDENGINE_REST_PORT=6041
# 镜像默认密码是 taosdata, 这里统一改成 onepark123, 与下面的 DSN 保持一致
TDENGINE_PASSWORD=onepark123
TDENGINE_DSN=root:onepark123@tcp(tdengine:6030)/device
# device-service 经 REST 写时序库(device-api.yaml: TDengine.Endpoint/Token); Token 留空即无鉴权
TDENGINE_REST=http://tdengine:6041
TDENGINE_TOKEN=

# ===== Kafka =====
KAFKA_PORT=9092

# ===== EMQX =====
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
# Dashboard 默认账号: admin / public
# device-service / event-dispatcher 连接 MQTT 的账号(EMQX 默认允许匿名, 留空即匿名)
EMQX_USERNAME=
EMQX_PASSWORD=

# ===== Nacos =====
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_KEY=onepark
NACOS_AUTH_VALUE=onepark123
# 默认账号: nacos / nacos

# ===== MinIO =====
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=onepark123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Elasticsearch =====
ES_PASSWORD=onepark123
ES_PORT=9200

# ===== 应用层通用配置 (服务 etc/*.yaml 通过环境变量引用) =====
HTTP_HOST=0.0.0.0
RPC_HOST=0.0.0.0
NACOS_HOST=nacos
NACOS_NS=onepark
NACOS_GROUP=DEFAULT_GROUP
REDIS_HOST=redis
REDIS_ADDR=redis:6379
REDIS_PASS=onepark123
REDIS_DB=0
KAFKA_BROKERS=kafka:9092

# M3 安防 mysql DSN (每服务独立库)
ALARM_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/alarm_db?charset=utf8mb4&parseTime=True&loc=Local
ALARM_KAFKA_GROUP=alarm-service
# M3 历史告警检索 ES 地址 (alarm-service #41 检索 / #44 双写); 留空则降级 MySQL
ALARM_ES_URL=http://127.0.0.1:9200
EMQX_BROKER=tcp://emqx:1883
TDENGINE_DSN=root:onepark123@tcp(tdengine:6030)/device

# JWT (网关鉴权 AUTH_SECRET 与 auth-service JWT_SECRET 必须一致)
JWT_SECRET=onepark-jwt-secret-please-change-in-prod
# 网关 apigateway-api.yaml 读取 ${AUTH_SECRET}(静态部署非 compose 时需显式提供); 必须等于 JWT_SECRET
AUTH_SECRET=onepark-jwt-secret-please-change-in-prod
# 注: auth-service 用单一 JWT_SECRET 签发 access/refresh(以 token Type 区分), 过期时间取自服务配置(JwtExpire/JwtRefresh);
# 此处不再单独提供 JWT_ACCESS_SECRET/EXPIRE/REFRESH_EXPIRE(历史遗留, 全仓无引用, 已移除避免误导).

# ===== 核心联调链服务端口 =====
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8088

# auth-service 用户中心库(sys_db, 由 deploy/sql 初始化)
AUTH_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/sys_db?charset=utf8mb4&parseTime=True&loc=Local
# auth-service 令牌注销黑名单 Redis(auth-api.yaml 的 ${AUTH_REDIS_ADDR}/${AUTH_REDIS_PASS}); 留空则注销降级为无操作
AUTH_REDIS_ADDR=redis:6379
AUTH_REDIS_PASS=onepark123

# Nacos 客户端凭证(用于网关拉取上游表)
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# 网关连接到 Nacos 的地址(留空则网关使用静态 apigateway-api.yaml 上游)
NACOS_ADDRESS=nacos:8848

# ===== M1 物联接入底座 (device-service / shadow-service / event-dispatcher) =====
# device-service 的 etc/device-api.yaml 引用 ${DEVICE_MYSQL_DSN}; shadow-service 的 etc/shadow.yaml 引用 ${MYSQL_DSN}
DEVICE_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/device_db?charset=utf8mb4&parseTime=True&loc=Local
SHADOW_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/shadow_db?charset=utf8mb4&parseTime=True&loc=Local
# device-service / access-control-service / visitor-service 经 M1 gRPC 远程开门; 容器内指向 device-service, 本地联调回退 127.0.0.1
DEVICE_RPC_ENDPOINTS=device-service:9001
# event-dispatcher 订阅配置
EMQX_CLIENT=event-dispatcher
EMQX_TOPIC=onepark/device/#

# ===== M2 业务库 DSN (每服务独立库, 由 deploy/sql 初始化; 引用见各 etc/*-api.yaml) =====
WORKORDER_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/workorder_db?charset=utf8mb4&parseTime=True&loc=Local
VISITOR_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/visitor_db?charset=utf8mb4&parseTime=True&loc=Local
PARKING_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/parking_db?charset=utf8mb4&parseTime=True&loc=Local
NOTICE_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/notice_db?charset=utf8mb4&parseTime=True&loc=Local

# ===== M3 安防/接入库 DSN =====
ACCESS_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/access_db?charset=utf8mb4&parseTime=True&loc=Local
VIDEO_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/video_db?charset=utf8mb4&parseTime=True&loc=Local

# ===== M4 能耗库 DSN =====
# energy-data-service 写入 energy_reading(落 billing_db, 见 deploy/sql/m2_energy_reading.sql), 故复用 billing_db 连接串;
# energy-analysis-service 分析库为独立 energy_analysis_db(无自有表, 仅连接占位).
ENERGY_DATA_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/billing_db?charset=utf8mb4&parseTime=True&loc=Local
ENERGY_ANALYSIS_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/energy_analysis_db?charset=utf8mb4&parseTime=True&loc=Local

# ===== M5 运营库 DSN =====
LEASING_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/leasing_db?charset=utf8mb4&parseTime=True&loc=Local
DASHBOARD_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/dashboard_db?charset=utf8mb4&parseTime=True&loc=Local
DISPATCH_MYSQL_DSN=root:onepark123@tcp(mysql:3306)/dispatch_db?charset=utf8mb4&parseTime=True&loc=Local

# ===== M3 video-service 流媒体下发 (留空 = 仅返回 RTSP / 关闭签名链路, 见 video-api.yaml) =====
VIDEO_FLV_BASE_URL=
VIDEO_STREAM_SIGN_SECRET=

# ===== M6 workorder-service MinIO 附件存储 (workorder-api.yaml) =====
WORKORDER_MINIO_ENDPOINT=http://minio:9000
WORKORDER_MINIO_ACCESS_KEY=admin
WORKORDER_MINIO_SECRET_KEY=onepark123
WORKORDER_MINIO_PUBLIC_URL=http://127.0.0.1:9000

# ===== 新增业务服务端口(部署时按需覆盖) =====
PARKING_SERVICE_PORT=8084
VISITOR_SERVICE_PORT=8083
NOTICE_SERVICE_PORT=8085
ACCESS_SERVICE_PORT=8010
ENERGY_DATA_SERVICE_PORT=8061
ENERGY_DATA_GRPC_PORT=9061
ENERGY_ANALYSIS_SERVICE_PORT=8062
VIDEO_SERVICE_PORT=8011
SHADOW_SERVICE_PORT=9002
