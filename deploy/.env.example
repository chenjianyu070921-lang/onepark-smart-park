# OnePark 智慧园区 - 中间件配置
# 复制为 .env 后按需修改: cp .env.example .env

# ===== 镜像版本 =====
MYSQL_VERSION=8.0
REDIS_VERSION=7-alpine
TDENGINE_VERSION=3.3.3.0
KAFKA_VERSION=3.7
EMQX_VERSION=5.5.1
NACOS_VERSION=v2.4.3
MINIO_VERSION=latest
ES_VERSION=8.13.4

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=onepark123
MYSQL_PORT=3306

# ===== Redis =====
REDIS_PASSWORD=onepark123
REDIS_PORT=6379

# ===== TDengine =====
TDENGINE_PORT=6030
TDENGINE_REST_PORT=6041
# 镜像默认密码是 taosdata, 这里统一改成 onepark123, 与下面的 DSN 保持一致
TDENGINE_PASSWORD=onepark123
TDENGINE_DSN=root:onepark123@tcp(tdengine:6030)/device

# ===== Kafka =====
KAFKA_PORT=9092

# ===== EMQX =====
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
# Dashboard 默认账号: admin / public

# ===== Nacos =====
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_KEY=onepark
NACOS_AUTH_VALUE=onepark123
# 默认账号: nacos / nacos

# ===== MinIO =====
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=onepark123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Elasticsearch =====
ES_PASSWORD=onepark123
ES_PORT=9200

# ===== 应用层通用配置 (服务 etc/*.yaml 通过环境变量引用) =====
HTTP_HOST=0.0.0.0
RPC_HOST=0.0.0.0
NACOS_HOST=nacos
NACOS_NS=onepark
NACOS_GROUP=DEFAULT_GROUP
REDIS_HOST=redis
KAFKA_BROKERS=kafka:9092
EMQX_BROKER=tcp://emqx:1883
TDENGINE_DSN=root:onepark123@tcp(tdengine:6030)/device

# JWT
JWT_ACCESS_SECRET=onepark-access-secret-please-change-in-prod
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ===== M1 物联接入底座 (device-service / shadow-service / event-dispatcher) =====
# device-service 的 etc/device-api.yaml 与 shadow-service 的 etc/shadow.yaml 引用
MYSQL_DSN=root:onepark123@tcp(mysql:3306)/onepark-smart-park?charset=utf8mb4&parseTime=true&loc=Local
# event-dispatcher 订阅配置
EMQX_CLIENT=event-dispatcher
EMQX_TOPIC=onepark/device/#
