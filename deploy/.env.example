# ============================================================
# OnePark 开发环境环境变量示例
# 使用: docker compose -f deploy/docker-compose.yml --env-file deploy/.env.example up -d
#      (或 cp deploy/.env.example deploy/.env 后省略 --env-file)
# 说明: 仅含占位默认值, 生产环境请替换为强密码.
# ============================================================

# ---- MySQL ----
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=onepark123
MYSQL_PORT=3306

# ---- Redis ----
REDIS_VERSION=7
REDIS_PASSWORD=onepark123
REDIS_PORT=6379

# ---- TDengine ----
TDENGINE_VERSION=3.2.0.0
TDENGINE_PORT=6030
TDENGINE_REST_PORT=6041

# ---- Kafka ----
KAFKA_VERSION=3.9
KAFKA_PORT=9092

# ---- EMQX ----
EMQX_VERSION=5.7
EMQX_MQTT_PORT=1883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083

# ---- Nacos ----
NACOS_VERSION=2.3.2
NACOS_AUTH_TOKEN=onepark-nacos-token
NACOS_AUTH_KEY=onepark-nacos-key
NACOS_AUTH_VALUE=onepark-nacos-value
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848

# ---- MinIO ----
MINIO_ROOT_USER=onepark
MINIO_ROOT_PASSWORD=onepark123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Elasticsearch ----
ES_VERSION=8.13.4
ES_PASSWORD=onepark123
ES_PORT=9200

# ---- 业务服务 ----
# device-service 连接的库(对齐 deploy/sql/init.sql 建的 device_db)
MYSQL_DATABASE=device_db
DEVICE_SERVICE_PORT=8001
# user-manage 连接的库(对齐 deploy/sql/sys.sql 建的 sys_db); 端口 8086
USER_MANAGE_PORT=8086

# auth-service JWT 签名密钥(必填; 缺失会导致 auth 服务启动时 panic)
JWT_SECRET=onepark-jwt-secret-change-me-in-prod
